{
  "name": "quiz-api",
  "version": "1.0.0",
  "description": "REST API for a quiz app on AI development concepts",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "db:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:seed": "nest build && node dist/seed/run-seed.js",
    "smoke": "nest build && node scripts/smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@swc/core": "1.16.22",
    "@types/node": "22.20.5",
    "oxlint": "1.94.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  },
  "private": true
}
